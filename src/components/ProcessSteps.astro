---
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
const colors = ['var(--sky)', 'var(--butter)', 'var(--leaf)', 'var(--sand)'];
---

<ol class="steps" style={`--n: ${steps.length}`}>
  {
    steps.map((step, i) => (
      <li class="card">
        <span class="num" style={`background:${colors[i % colors.length]}`}>
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3>{step.title}</h3>
        <p class="muted">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 16px 16px 18px;
  }

  /* 步驟之間的箭頭 */
  li:not(:last-child)::after {
    content: '›';
    position: absolute;
    top: 50%;
    right: -20px;
    color: var(--muted);
    font-size: 1.4rem;
    line-height: 0;
  }

  .num {
    display: inline-block;
    margin-bottom: 12px;
    padding: 0.15em 0.55em;
    border-radius: 4px;
    font: 600 0.8rem/1.4 var(--font-body);
  }

  h3 {
    margin-bottom: 6px;
    font-size: 1.1rem;
    font-weight: 600;
  }

  p {
    margin: 0;
    font-size: 0.9rem;
  }

  /* 平板：兩欄、不顯示箭頭 */
  @media (max-width: 1199px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    li:not(:last-child)::after {
      display: none;
    }
  }

  /* 手機：一欄，箭頭改成往下 */
  @media (max-width: 809px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    li:not(:last-child)::after {
      display: block;
    }

    li:not(:last-child)::after {
      content: '⌄';
      top: auto;
      right: auto;
      bottom: -10px;
      left: 50%;
    }
  }
</style>
