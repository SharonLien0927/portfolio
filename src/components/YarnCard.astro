---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { splitId } from '../lib/content';
import { localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'yarn'>;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const { title, summary, status, kind, cover } = entry.data;
// 手作日常不接單，標籤改顯示「手作日常」
const tagClass = kind === 'daily' ? 'daily' : status;
const tagLabel = kind === 'daily' ? t(lang)('yarn.daily') : t(lang)(`yarn.status.${status}`);
const tints = ['#fff5d4', '#e3f6fd', '#eef7e7', '#fff9c2'];
const href = localePath(lang, `yarn/${splitId(entry.id).slug}/`);
---

<article class="piece card">
  <a class="link" href={href}>
  <div class="media" style={`background:${tints[index % tints.length]}`}>
    {
      cover ? (
        <Image src={cover} alt={title} widths={[400, 700]} sizes="(min-width: 1200px) 20vw, (min-width: 810px) 30vw, 50vw" />
      ) : (
        <svg class="yarn" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" />
          <path d="M20 40c18 6 40 4 60-10M17 56c22 8 46 6 66-12M25 72c16 4 36 0 50-14M42 17c-6 20-4 46 10 68" />
        </svg>
      )
    }
  </div>
  <div class="info">
    <div class="head">
      <h3>{title}</h3>
      <span class:list={['tag', tagClass]}>{tagLabel}</span>
    </div>
    <p class="muted">{summary}</p>
  </div>
  </a>
</article>

<style>
  .link {
    display: block;
    text-decoration: none;
  }

  .link:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .piece {
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .piece:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
  }

  .media {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin: 6px;
    overflow: hidden;
    border-radius: 4px;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yarn {
    width: 52%;
    fill: var(--leaf);
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    transition: transform 0.4s ease;
  }

  .piece:hover .yarn {
    transform: rotate(-12deg);
  }

  .yarn path {
    fill: none;
  }

  .info {
    padding: 6px 14px 14px;
  }

  /* 卡片夠寬時標題和標籤同一行，太窄（四欄、手機兩欄）時標籤自動換到下一行 */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 4px 8px;
  }

  h3 {
    flex: 1 1 7.5em;
    font-size: 1.05rem;
    font-weight: 600;
  }


  .tag {
    flex-shrink: 0;
  }

  .tag.available { background: #cdeab8; }
  .tag.daily { background: transparent; box-shadow: inset 0 0 0 1px currentColor; opacity: 0.75; }
  .tag.sold { background: var(--sand); color: var(--muted); }

  p {
    margin: 6px 0 0;
    font-size: 0.88rem;
  }
  @media (max-width: 809px) {
    .info {
      padding: 4px 10px 12px;
    }

    h3 {
      font-size: 0.95rem;
    }

    p {
      font-size: 0.8rem;
    }
  }
</style>
