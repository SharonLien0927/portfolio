---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { splitId } from '../lib/content';
import { assetUrl, localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const { title, summary, year, tags, cover, video } = entry.data;
const href = localePath(lang, `projects/${splitId(entry.id).slug}/`);
const tint = ['var(--sky)', 'var(--leaf)', 'var(--butter)'][index % 3];
---

<article class="card">
  <a href={href} data-hover-video>
    <div class="media" style={`--tint: ${tint}`}>
      {
        cover ? (
          <Image src={cover} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
        ) : (
          <div class="placeholder" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
        )
      }
      {video && <video muted loop playsinline preload="none" data-src={assetUrl(video)} aria-hidden="true" />}
      <span class="view">{t(lang)('projects.view')} →</span>
    </div>
    <div class="meta">
      <h3>{title}</h3>
      <span class="year">{year}</span>
    </div>
    <p class="muted">{summary}</p>
    <ul class="tags">{tags.map((tag) => <li>{tag}</li>)}</ul>
  </a>
</article>

<style>
  .card a {
    display: block;
    text-decoration: none;
  }

  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    background: var(--tint);
    transition: border-radius 0.3s ease;
  }

  .media img,
  .media video,
  .placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media video {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .media :global(video.playing) {
    opacity: 1;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.5), transparent 45%),
      var(--tint);
  }

  .placeholder span {
    font: 700 clamp(4rem, 10vw, 8rem) / 1 var(--font-display);
    opacity: 0.25;
  }

  .view {
    position: absolute;
    right: 16px;
    bottom: 16px;
    padding: 0.4em 1em;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
  }

  a:hover .media,
  a:focus-visible .media {
    border-radius: 56px;
  }

  a:hover .view,
  a:focus-visible .view {
    opacity: 1;
    transform: none;
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 18px 0 6px;
  }

  h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  }

  .year {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  @media (hover: none) {
    .view {
      opacity: 1;
      transform: none;
    }
  }
</style>
