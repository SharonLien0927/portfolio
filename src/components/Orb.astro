---
// 圓形圖示：3D 方塊、毛線球。大標題和左上角標誌共用，確保兩邊長得一樣
interface Props {
  kind: 'cube' | 'yarn';
  /** 直徑，任何 CSS 長度；預設跟著文字大小 */
  size?: string;
  /** 方塊慢慢旋轉（大標題用） */
  spin?: boolean;
}

const { kind, size = '0.82em', spin = false } = Astro.props;
---

<span class:list={['orb', kind, { spin }]} style={`--orb-size: ${size}`} aria-hidden="true">
  {
    kind === 'cube' ? (
      <svg viewBox="0 0 100 100">
        <path class="face" d="M50 18 80 35v32L50 84 20 67V35z" />
        <path class="edge" d="M50 52 80 35M50 52 20 35M50 52v32" />
        <path class="edge" d="M50 18 80 35v32L50 84 20 67V35z" />
      </svg>
    ) : (
      <svg viewBox="0 0 100 100">
        <path class="thread" d="M14 42c22 8 48 6 72-12M10 58c26 10 56 8 80-12M20 76c20 6 44 2 62-14M38 10c-8 26-6 56 12 84M60 8c-12 28-10 62 10 86" />
      </svg>
    )
  }
</span>

<style>
  /* inline-block + overflow:hidden：基線固定在圓形底部，放在文字裡也對齊 */
  .orb {
    display: inline-block;
    flex-shrink: 0;
    overflow: hidden;
    width: var(--orb-size);
    height: var(--orb-size);
    border-radius: 50%;
    vertical-align: -0.06em;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cube {
    background: conic-gradient(from 200deg, var(--sky), #8fdcf6, var(--butter), var(--sky));
  }

  .face {
    fill: #fffdea;
  }

  .edge {
    fill: none;
    stroke: #1c1b18;
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .yarn {
    background: radial-gradient(circle at 35% 30%, #9ad46f, var(--leaf) 60%);
  }

  /* 毛線用白線 */
  .thread {
    fill: none;
    stroke: #ffffff;
    stroke-width: 3.5;
    stroke-linecap: round;
  }

  .spin {
    animation: spin 14s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
