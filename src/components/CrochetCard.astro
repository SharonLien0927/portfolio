---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'crochet'>;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const { title, summary, status, cover } = entry.data;
const tints = ['#fff5d4', '#e3f6fd', '#eef7e7', '#fff9c2'];
---

<article class="piece card">
  <div class="media" style={`background:${tints[index % tints.length]}`}>
    {
      cover ? (
        <Image src={cover} alt={title} widths={[400, 700]} sizes="(min-width: 1000px) 25vw, 100vw" />
      ) : (
        <svg class="yarn" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" />
          <path d="M20 40c18 6 40 4 60-10M17 56c22 8 46 6 66-12M25 72c16 4 36 0 50-14M42 17c-6 20-4 46 10 68" />
        </svg>
      )
    }
  </div>
  <div class="info">
    <div class="head">
      <h3>{title}</h3>
      <span class:list={['tag', status]}>{t(lang)(`crochet.status.${status}`)}</span>
    </div>
    <p class="muted">{summary}</p>
  </div>
</article>

<style>
  .piece {
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .piece:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
  }

  .media {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin: 6px;
    overflow: hidden;
    border-radius: 4px;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yarn {
    width: 52%;
    fill: var(--leaf);
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    transition: transform 0.4s ease;
  }

  .piece:hover .yarn {
    transform: rotate(-12deg);
  }

  .yarn path {
    fill: none;
  }

  .info {
    padding: 6px 14px 14px;
  }

  .head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 8px;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .tag {
    flex-shrink: 0;
  }

  .tag.available { background: #cdeab8; }
  .tag.sold { background: var(--sand); color: var(--muted); }

  p {
    margin: 6px 0 0;
    font-size: 0.88rem;
  }
</style>
