---
import { render } from 'astro:content';
import Logo from './Logo.astro';
import { getPage } from '../lib/content';
import { localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const page = await getPage('yarn-soon', lang);
const { Content } = await render(page);
---

<div class="soon">
  <div class="head">
    <Logo size={22} />
    <span class="tag lc">{tr('soon.badge')}</span>
  </div>
  <h2>{page.data.title}</h2>
  <div class="body"><Content /></div>
  <a class="btn btn--butter lc" href={localePath(lang, '#contact')}>{tr('soon.cta')} →</a>
</div>

<style>
  .soon {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(24px, 5vw, 48px);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(-45deg, transparent 0 18px, rgb(255 253 234 / 0.04) 18px 20px),
      var(--ink);
    color: var(--paper);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tag {
    color: var(--ink);
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .body {
    max-width: 52ch;
    color: rgb(255 253 234 / 0.75);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
