---
import LangSwitch from './LangSwitch.astro';
import { t, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const tr = t(lang);
const links = [
  { href: localePath(lang, '#projects'), label: tr('nav.projects') },
  { href: localePath(lang, '#services'), label: tr('nav.services') },
  { href: localePath(lang, '#about'), label: tr('nav.about') },
  { href: localePath(lang, 'crochet/'), label: tr('nav.crochet') },
];
---

<header class="site-header">
  <nav class="bar container" aria-label="Main">
    <a class="brand" href={localePath(lang)}>
      <span class="dots" aria-hidden="true"><i></i><i></i></span>
      {site.name[lang]}
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="bars" aria-hidden="true"></span>
      <span class="visually-hidden">{tr('nav.menu')}</span>
    </button>
    <ul id="nav-links" class="links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><LangSwitch lang={lang} alternate={alternate} /></li>
      <li><a class="btn btn--ink contact" href={localePath(lang, '#contact')}>{tr('nav.contact')}</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const list = document.getElementById('nav-links');
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    list?.classList.toggle('open', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  list?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    margin-top: 12px;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 10px 10px 20px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: rgb(255 253 234 / 0.9);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 700 1.05rem/1 var(--font-display);
    text-decoration: none;
  }

  .dots {
    display: inline-flex;
  }

  .dots i {
    width: 18px;
    height: 18px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--sky);
  }

  .dots i + i {
    margin-left: -6px;
    background: var(--leaf);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a:not(.btn) {
    display: block;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s;
  }

  .links a:not(.btn):hover {
    background: var(--butter);
  }

  .contact {
    margin-left: 6px;
    padding: 0.6em 1.2em;
    box-shadow: none;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--butter);
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--ink);
    transition: transform 0.2s;
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
  }

  .bars::before { top: -6px; }
  .bars::after { top: 6px; }

  [aria-expanded='true'] .bars { background: transparent; }
  [aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 860px) {
    .menu-toggle {
      display: block;
    }

    .links {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      padding: 12px;
      border: 2px solid var(--ink);
      border-radius: var(--radius-lg);
      background: var(--paper);
    }

    .links.open {
      display: flex;
    }

    .links a:not(.btn) {
      padding: 0.8em 1em;
      font-size: 1.1rem;
    }

    .contact {
      justify-content: center;
      margin: 8px 0 0;
    }
  }
</style>
