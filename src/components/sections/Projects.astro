---
import { Image } from 'astro:assets';
import { splitId, getLocalized } from '../../lib/content';
import { assetUrl, localePath, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const projects = await getLocalized('projects', lang);
const [featured, ...others] = projects;
// 首頁只放精選 + 最新三件，其餘在 /3d/ 頁
const rest = others.slice(0, 3);
const href = (id: string) => localePath(lang, `projects/${splitId(id).slug}/`);
const tints = ['#30c0f0', '#67b935', '#fff385', '#fbefc7'];
---

<section id="projects" class="section projects">
  {
    featured && (
      <a class="featured" href={href(featured.id)} data-hover-video>
        <div class="media" style={`--tint: ${tints[0]}`}>
          {featured.data.cover ? (
            <Image src={featured.data.cover} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 1000px) 70vw, 100vw" />
          ) : (
            <div class="placeholder" aria-hidden="true" />
          )}
          {featured.data.video && (
            <video muted loop playsinline preload="none" data-src={assetUrl(featured.data.video)} aria-hidden="true" />
          )}
        </div>
        <span class="tag label">{tr('projects.featured')}</span>
        <div class="caption">
          <h2>{featured.data.title}</h2>
          <p>{featured.data.tags.join(', ')}</p>
          <p class="year">{featured.data.year}</p>
        </div>
      </a>
    )
  }

  <ul class="list" data-preview-list>
    {
      rest.map((p, i) => (
        <li>
          <a
            class="row"
            href={href(p.id)}
            data-video={p.data.video ? assetUrl(p.data.video) : undefined}
            data-image={p.data.cover?.src}
            style={`--tint: ${tints[(i + 1) % tints.length]}`}
          >
            <span class="thumb">
              {p.data.cover ? <Image src={p.data.cover} alt="" width={160} /> : <span class="placeholder" />}
            </span>
            <strong class="title">{p.data.title}</strong>
            <span class="cat muted">{p.data.tags.join(', ')}</span>
            <span class="year">{p.data.year}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="all lc" href={localePath(lang, '3d/')}>{tr('projects.all')} →</a>

  <!-- 滑鼠移到列表上時跟著游標的預覽小窗 -->
  <div class="preview" aria-hidden="true" data-preview>
    <img alt="" />
    <video muted loop playsinline></video>
  </div>
</section>

<script>
  import '../../scripts/hover-video.ts';

  // 列表 hover 預覽：只在有滑鼠的裝置上啟用
  const list = document.querySelector<HTMLElement>('[data-preview-list]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  if (list && preview && matchMedia('(hover: hover)').matches) {
    const img = preview.querySelector('img')!;
    const video = preview.querySelector('video')!;

    list.addEventListener('pointermove', (e) => {
      preview.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 80}px)`;
    });

    list.querySelectorAll<HTMLAnchorElement>('.row').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        const { video: src, image } = row.dataset;
        preview.style.setProperty('--tint', row.style.getPropertyValue('--tint'));
        img.hidden = !image;
        if (image) img.src = image;
        if (src) {
          video.src = src;
          video.play().catch(() => {});
        } else {
          video.removeAttribute('src');
        }
        preview.classList.add('show');
      });
      row.addEventListener('pointerleave', () => {
        preview.classList.remove('show');
        video.pause();
      });
    });
  }
</script>

<style>
  .projects {
    padding-top: 0;
  }

  /* ---------- 精選作品 ---------- */
  .featured {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    color: var(--white);
    text-decoration: none;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 8;
    background: var(--tint);
  }

  .media img,
  .media video,
  .media .placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media video {
    opacity: 0;
    transition: opacity 0.3s;
  }

  .media :global(video.playing) {
    opacity: 1;
  }

  .media .placeholder {
    background:
      radial-gradient(circle at 70% 35%, rgb(255 255 255 / 0.55), transparent 30%),
      radial-gradient(circle at 25% 80%, var(--leaf), transparent 45%),
      linear-gradient(160deg, var(--sky), #1d8fc0);
  }

  .media::after {
    content: '';
    position: absolute;
    inset: 50% 0 0;
    background: linear-gradient(transparent, rgb(28 27 24 / 0.55));
  }

  .label {
    position: absolute;
    top: 12px;
    left: 12px;
    color: var(--ink);
  }

  html:lang(en) .label {
    text-transform: lowercase;
  }

  .caption {
    position: absolute;
    right: 20px;
    bottom: 16px;
    left: 20px;
    z-index: 1;
  }

  .caption h2 {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 600;
  }

  .caption p {
    margin: 2px 0 0;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .caption .year {
    margin-top: 12px;
  }

  .featured img {
    transition: transform 0.6s ease;
  }

  .featured:hover img {
    transform: scale(1.03);
  }

  /* ---------- 作品列表 ---------- */
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 70px minmax(0, 1.3fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1.5px dashed var(--dash);
    text-decoration: none;
    transition: background 0.2s, padding 0.2s;
  }

  .row:hover {
    padding-inline: 10px;
    background: var(--cream);
  }

  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    background: var(--tint);
  }

  .thumb :global(img),
  .thumb .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title {
    font: 600 1.05rem/1.3 var(--font-display);
  }

  .cat {
    font-size: 0.85rem;
  }

  .row .year {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 240px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--tint, var(--sky));
    box-shadow: 0 12px 30px rgb(28 27 24 / 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .preview.show {
    opacity: 1;
  }

  .preview :is(img, video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview video:not([src]) {
    display: none;
  }

  /* 看全部 3D 作品 */
  .all {
    display: flex;
    justify-content: flex-end;
    padding: 14px 0 0;
    font-weight: 600;
    text-decoration: none;
  }

  .all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 809px) {
    .media {
      aspect-ratio: 4 / 3;
    }

    .row {
      grid-template-columns: 60px 1fr auto;
      gap: 12px;
    }

    .cat {
      display: none;
    }
  }
</style>
