---
import { Image } from 'astro:assets';
import poster from '../../assets/images/showreel-poster.jpg';
import { splitId, getLocalized } from '../../lib/content';
import { assetUrl, localePath, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const projects = await getLocalized('projects', lang);
// 首頁只放 Showreel + 三件作品（每個分類各取排序最前面的一件，讓類型多樣），其餘在 /3d/ 頁
const firstOfEach = projects.filter((p, i) => projects.findIndex((q) => q.data.category === p.data.category) === i);
const rest = [...firstOfEach, ...projects.filter((p) => !firstOfEach.includes(p))].slice(0, 3);
// Showreel 影片放 public/videos/：teaser 是首頁循環播放的短片段，full 是完整版
const reel = { title: '2024 Showreel', teaser: 'videos/showreel-2024-teaser.mp4', full: 'videos/showreel-2024.mp4' };
const href = (id: string) => localePath(lang, `projects/${splitId(id).slug}/`);
const tints = ['#30c0f0', '#67b935', '#fff385', '#fbefc7'];
---

<section id="projects" class="section projects">
  <!-- 精選：Showreel。平常靜音循環播放片段，點了播放完整版（有聲音、有播放控制） -->
  <div class="reel" data-reel>
    <div class="media">
      <Image src={poster} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 1000px) 70vw, 100vw" />
      <video class="teaser" muted loop playsinline preload="none" data-src={assetUrl(reel.teaser)} aria-hidden="true"></video>
      <video class="full" playsinline preload="none" controls data-src={assetUrl(reel.full)} hidden></video>
    </div>
    <span class="tag label">{tr('projects.featured')}</span>
    <button class="play" type="button" data-reel-play>
      <span class="icon" aria-hidden="true">▶</span>
      <span>{tr('reel.play')}</span>
    </button>
    <div class="caption">
      <h2>{reel.title}</h2>
      <p>{tr('reel.desc')}</p>
    </div>
  </div>

  <ul class="list" data-preview-list>
    {
      rest.map((p, i) => (
        <li>
          <a
            class="row"
            href={href(p.id)}
            data-video={p.data.video ? assetUrl(p.data.video) : undefined}
            data-image={p.data.cover?.src}
            style={`--tint: ${tints[(i + 1) % tints.length]}`}
          >
            <span class="thumb">
              {p.data.cover ? <Image src={p.data.cover} alt="" width={160} /> : <span class="placeholder" />}
            </span>
            <strong class="title">{p.data.title}</strong>
            <span class="cat muted">{p.data.category}</span>
            <span class="year">{p.data.year}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="all lc" href={localePath(lang, '3d/')}>{tr('projects.all')} →</a>

  <!-- 滑鼠移到列表上時跟著游標的預覽小窗 -->
  <div class="preview" aria-hidden="true" data-preview>
    <img alt="" />
    <video muted loop playsinline></video>
  </div>
</section>

<script>
  import '../../scripts/hover-video.ts';

  // Showreel：進到畫面才載入並播放靜音片段；按播放鍵換成完整版
  const reelBox = document.querySelector<HTMLElement>('[data-reel]');
  if (reelBox) {
    const teaser = reelBox.querySelector<HTMLVideoElement>('video.teaser')!;
    const full = reelBox.querySelector<HTMLVideoElement>('video.full')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!still) {
      new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (reelBox.classList.contains('playing-full')) continue;
          if (e.isIntersecting) {
            if (!teaser.src) teaser.src = teaser.dataset.src!;
            teaser.play().then(() => teaser.classList.add('playing')).catch(() => {});
          } else {
            teaser.pause();
          }
        }
      }, { threshold: 0.25 }).observe(reelBox);
    }
    reelBox.querySelector('[data-reel-play]')!.addEventListener('click', () => {
      teaser.pause();
      full.src = full.dataset.src!;
      full.hidden = false;
      reelBox.classList.add('playing-full');
      full.play().catch(() => {});
    });
  }

  // 列表 hover 預覽：只在有滑鼠的裝置上啟用
  const list = document.querySelector<HTMLElement>('[data-preview-list]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  if (list && preview && matchMedia('(hover: hover)').matches) {
    const img = preview.querySelector('img')!;
    const video = preview.querySelector('video')!;

    list.addEventListener('pointermove', (e) => {
      preview.style.transform = `translate(${e.clientX + 24}px, ${e.clientY - 80}px)`;
    });

    list.querySelectorAll<HTMLAnchorElement>('.row').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        const { video: src, image } = row.dataset;
        preview.style.setProperty('--tint', row.style.getPropertyValue('--tint'));
        img.hidden = !image;
        if (image) img.src = image;
        if (src) {
          video.src = src;
          video.play().catch(() => {});
        } else {
          video.removeAttribute('src');
        }
        preview.classList.add('show');
      });
      row.addEventListener('pointerleave', () => {
        preview.classList.remove('show');
        video.pause();
      });
    });
  }
</script>

<style>
  .projects {
    padding-top: 0;
  }

  /* ---------- 精選：Showreel ---------- */
  .reel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    color: var(--white);
    background: #000;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .media :global(img),
  .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media .teaser {
    opacity: 0;
    transition: opacity 0.4s;
  }

  .media .teaser:global(.playing) {
    opacity: 1;
  }

  .media .full[hidden] {
    display: none;
  }

  .media .full {
    z-index: 2;
    object-fit: contain;
    background: #000;
  }

  .media::after {
    content: '';
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgb(10 10 20 / 0.6));
    pointer-events: none;
  }

  .label {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    color: var(--ink);
  }

  html:lang(en) .label {
    text-transform: lowercase;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0.8em 1.4em 0.8em 0.9em;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    color: #fff;
    background: rgb(20 20 40 / 0.45);
    backdrop-filter: blur(10px);
    font: 600 1rem/1 var(--font-display);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: transform 0.25s, background 0.25s;
  }

  .play:hover {
    background: rgb(20 20 40 / 0.65);
    transform: translate(-50%, -50%) scale(1.05);
  }

  .play .icon {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    color: #1a1840;
    background: #fff;
    font-size: 0.8em;
    padding-left: 0.15em;
  }

  .caption {
    position: absolute;
    right: 20px;
    bottom: 16px;
    left: 20px;
    z-index: 1;
    pointer-events: none;
  }

  .caption h2 {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 600;
  }

  .caption p {
    margin: 2px 0 0;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  /* 播放完整版時，把按鈕、標籤和說明收起來，讓影片控制列可以點 */
  .playing-full :is(.play, .label, .caption),
  .playing-full .media::after {
    display: none;
  }

  /* ---------- 作品列表 ---------- */
  .list {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 70px minmax(0, 1.3fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1.5px dashed var(--dash);
    text-decoration: none;
    transition: background 0.2s, padding 0.2s;
  }

  .row:hover {
    padding-inline: 10px;
    background: var(--cream);
  }

  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    background: var(--tint);
  }

  .thumb :global(img),
  .thumb .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title {
    font: 600 1.05rem/1.3 var(--font-display);
  }

  .cat {
    font-size: 0.85rem;
  }

  .row .year {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 240px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--tint, var(--sky));
    box-shadow: 0 12px 30px rgb(28 27 24 / 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .preview.show {
    opacity: 1;
  }

  .preview :is(img, video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview video:not([src]) {
    display: none;
  }

  /* 看全部 3D 作品 */
  .all {
    display: flex;
    justify-content: flex-end;
    padding: 14px 0 0;
    font-weight: 600;
    text-decoration: none;
  }

  .all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 809px) {
    .row {
      grid-template-columns: 60px 1fr auto;
      gap: 12px;
    }

    .cat {
      display: none;
    }
  }
</style>
