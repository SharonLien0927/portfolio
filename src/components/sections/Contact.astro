---
import { render } from 'astro:content';
import MadLibsForm from '../MadLibsForm.astro';
import { getPage } from '../../lib/content';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = await getPage('contact', lang);
const { Content } = await render(page);
---

<section id="contact" class="section contact">
  <div class="envelope">
    <div class="note">
      <h2>{page.data.title}</h2>
      <div class="intro muted"><Content /></div>
      <MadLibsForm lang={lang} />
    </div>
    <div class="pocket" aria-hidden="true"></div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 0;
  }

  .envelope {
    position: relative;
    max-width: 680px;
    margin-inline: auto;
  }

  /* 信封背面 */
  .envelope::before {
    content: '';
    position: absolute;
    inset: 38% -24px 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--cream);
  }

  .note {
    position: relative;
    margin-inline: 8px;
    padding: clamp(24px, 4vw, 34px) clamp(20px, 4vw, 34px) 120px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 6px 24px rgb(28 27 24 / 0.08);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 2.625rem);
    text-align: center;
  }

  .intro {
    margin: 8px 0 24px;
    text-align: center;
    font-size: 0.92rem;
  }

  .intro :global(p) {
    margin: 0;
  }

  /* 信封前片：兩個三角形蓋住信紙下緣 */
  .pocket {
    position: relative;
    height: 110px;
    margin: -90px -24px 0;
    background:
      linear-gradient(to top right, var(--sand) 50%, transparent 50.5%) left / 50.5% 100% no-repeat,
      linear-gradient(to top left, var(--sand) 50%, transparent 50.5%) right / 50.5% 100% no-repeat;
    pointer-events: none;
  }

  .pocket::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30px;
    background: var(--sand);
  }
</style>
