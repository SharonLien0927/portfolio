---
import { render } from 'astro:content';
import { getPage } from '../../lib/content';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = await getPage('about', lang);
const { Content } = await render(page);
---

<section id="about" class="section">
  <div class="container about">
    <div>
      <p class="eyebrow">{t(lang)('about.eyebrow')}</p>
      <h2 class="h2">{page.data.title}</h2>
    </div>
    <div class="body">
      <div class="prose"><Content /></div>
      {
        page.data.stats && (
          <dl class="stats">
            {page.data.stats.map((s) => (
              <div>
                <dt class="muted">{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
  }

  .body {
    padding-top: 8px;
    font-size: 1.15rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin: 32px 0 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    padding: 20px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  .stats div:nth-child(3n + 1) { box-shadow: 0 5px 0 var(--sky); }
  .stats div:nth-child(3n + 2) { box-shadow: 0 5px 0 var(--leaf); }
  .stats div:nth-child(3n) { box-shadow: 0 5px 0 var(--butter); }

  dd {
    margin: 0;
    font: 700 clamp(2rem, 4vw, 2.8rem) / 1.1 var(--font-display);
  }

  dt {
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
