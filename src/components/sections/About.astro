---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Logo from '../Logo.astro';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, subtitle, statement, quote, signature, stats, photo } = page.data;
// *星號* 包起來的字變成藍色強調
const statementParts = (statement ?? '').split(/\*(.+?)\*/);
---

<section id="about" class="section about">
  {
    statement && (
      <p class="statement">
        {statementParts.map((part, i) => (i % 2 ? <em>{part}</em> : part))}
      </p>
    )
  }

  {
    stats && (
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dd>{s.value}</dd>
            <dt class="muted">{s.label}</dt>
          </div>
        ))}
      </dl>
    )
  }

  <div class="letter-wrap">
    <article class="letter">
      <div class="photo" aria-hidden={photo ? undefined : 'true'}>
        {photo ? <Image src={photo} alt={signature ?? ''} width={320} /> : <Logo size={30} />}
        <span class="clip" aria-hidden="true"></span>
      </div>
      <h2>{title}</h2>
      {subtitle && <p class="subtitle lc">{subtitle}</p>}
      <div class="body"><Content /></div>
      {quote && <blockquote>“{quote}”</blockquote>}
      {signature && <p class="sign">{signature}</p>}
    </article>
  </div>
</section>

<style>
  .statement {
    max-width: 22em;
    margin: 0 auto clamp(32px, 5vw, 56px);
    font: 700 clamp(1.5rem, 3.4vw, 2.4rem) / 1.2 var(--font-display);
    text-align: center;
  }

  html:lang(en) .statement {
    text-transform: lowercase;
  }

  .statement em {
    color: var(--sky);
    font-style: normal;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    max-width: 820px;
    margin: 0 auto clamp(40px, 6vw, 72px);
  }

  .stats div {
    padding: 12px 16px;
    border-radius: var(--radius);
    background: var(--cream);
  }

  dd {
    margin: 0;
    font: 600 1.6rem/1.2 var(--font-display);
  }

  dt {
    font-size: 0.85rem;
  }

  /* 信紙：後面墊一張歪掉的紙 */
  .letter-wrap {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
  }

  .letter-wrap::before {
    content: '';
    position: absolute;
    inset: 24px -10px -18px 30px;
    border-radius: var(--radius);
    background: var(--sand);
    transform: rotate(-1.6deg);
  }

  .letter {
    position: relative;
    padding: clamp(24px, 4vw, 40px);
    border: 1.5px solid rgb(28 27 24 / 0.12);
    border-radius: var(--radius);
    background: var(--white);
  }

  .photo {
    position: absolute;
    top: -26px;
    right: clamp(16px, 4vw, 36px);
    display: grid;
    place-items: center;
    width: clamp(96px, 14vw, 130px);
    aspect-ratio: 1;
    overflow: visible;
    border: 5px solid var(--white);
    border-radius: 4px;
    background: var(--cream);
    box-shadow: 0 8px 20px rgb(28 27 24 / 0.15);
    transform: rotate(5deg);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 迴紋針 */
  .clip {
    position: absolute;
    top: -16px;
    right: 18px;
    width: 16px;
    height: 46px;
    border: 3px solid #9aa3a8;
    border-radius: 10px;
  }

  h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    font-weight: 600;
  }

  .subtitle {
    margin: 2px 0 28px;
    color: var(--sky);
    font-weight: 500;
  }

  .body {
    max-width: 60ch;
    color: var(--muted);
  }

  blockquote {
    margin: 24px 0;
    padding: 14px 18px;
    border: 1.5px dashed var(--dash);
    border-radius: var(--radius);
    background: var(--cream);
    font-weight: 600;
  }

  .sign {
    margin: 28px 0 0;
    font: 600 1.25rem/1.2 var(--font-display);
  }

  @media (max-width: 809px) {
    .letter {
      padding-top: 90px;
    }
  }
</style>
