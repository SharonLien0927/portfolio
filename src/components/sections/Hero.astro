---
import { render, type CollectionEntry } from 'astro:content';
import BigLines from '../BigLines.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  page: CollectionEntry<'pages'>;
  /** 大字用玻璃 3D 效果，滑鼠移動時會微微傾斜 */
  glass?: boolean;
}

const { lang, page, glass = false } = Astro.props;
const { Content } = await render(page);
const lines = page.data.lines ?? [page.data.title];
const [l1 = page.data.title, l2 = '', l3 = ''] = lines;
const since = page.data.since;
const sinceLabel = t(lang)('since');
const below = page.data.leadPosition === 'below';
---

<section class:list={['hero', { glass }]}>
  <h1 class="visually-hidden">{page.data.title}</h1>
  {
    below ? (
      /* 階梯排法：每一行往右錯開，最後一行接按鈕，下方是 since 徽章 + 簡介 */
      <div class="headline stair" style={`--steps: ${lines.length}`}>
        {lines.map((line, i) => (
          <div class:list={['row', { last: i === lines.length - 1 }]} style={`--i: ${i}`}>
            <span class="big" aria-hidden="true">
              <BigLines text={line} since={since} sinceLabel={sinceLabel} />
            </span>
            {i === lines.length - 1 && <div class="ctas"><slot /></div>}
          </div>
        ))}
        <div class="row foot" style={`--i: ${lines.length}`}>
          {since && (
            <span class="big" aria-hidden="true">
              <BigLines text="{since}" since={since} sinceLabel={sinceLabel} />
            </span>
          )}
          <div class="lead"><Content /></div>
        </div>
      </div>
    ) : (
      <div class="headline">
        <div class="row" aria-hidden="true">
          <span class="big"><BigLines text={l1} since={since} sinceLabel={sinceLabel} /></span>
        </div>
        <div class="row r2">
          <div class="lead"><Content /></div>
          <span class="big" aria-hidden="true"><BigLines text={l2} since={since} sinceLabel={sinceLabel} /></span>
        </div>
        <div class="row r3">
          <span class="big" aria-hidden="true"><BigLines text={l3} since={since} sinceLabel={sinceLabel} /></span>
          <div class="ctas"><slot /></div>
        </div>
      </div>
    )
  }
</section>

<script>
  // 玻璃字：滑鼠在大標題區移動時整組字微微傾斜（觸控裝置、減少動態效果時不啟用）
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover)').matches;
  if (!still) {
    for (const hero of document.querySelectorAll<HTMLElement>('.hero.glass')) {
      const headline = hero.querySelector<HTMLElement>('.headline');
      if (!headline) continue;
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        headline.style.setProperty('--ry', `${(x * 10).toFixed(2)}deg`);
        headline.style.setProperty('--rx', `${(-y * 8).toFixed(2)}deg`);
      });
      hero.addEventListener('pointerleave', () => {
        headline.style.setProperty('--ry', '0deg');
        headline.style.setProperty('--rx', '0deg');
      });
    }
  }
</script>

<style>
  .hero {
    display: grid;
    place-items: center;
    min-height: clamp(420px, 62svh, 640px);
    padding-block: 40px;
  }

  /* 字級跟著主欄寬度（cqi）縮放：大螢幕更大、平板自動換行 */
  .headline {
    display: grid;
    justify-items: center;
    gap: 0.1em;
    font: 700 max(2.6rem, 10.5cqi) / 0.95 var(--font-display);
    letter-spacing: -0.02em;
    text-align: center;
  }

  /* 中文字是滿版方塊，同字級看起來比英文大，縮一點 */
  :lang(zh-Hant-TW) .headline {
    font-size: max(2.4rem, 8.6cqi);
    letter-spacing: 0.02em;
  }

  html:lang(en) .big {
    text-transform: lowercase;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  .lead {
    flex-shrink: 0;
    max-width: 23em;
    font: 400 clamp(0.85rem, 1.15cqi, 1.05rem) / 1.45 var(--font-body);
    letter-spacing: 0;
    text-align: right;
    color: var(--muted);
  }

  .lead :global(p) {
    margin: 0;
  }

  .ctas {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 8px;
    font-size: clamp(0.95rem, 1.3cqi, 1.2rem);
    letter-spacing: 0;
  }

  .ctas :global(.btn) {
    justify-content: center;
    padding: 0.85em 1.4em;
    font-size: inherit;
  }

  /*
    階梯排法（中文版首頁）：
    兩行大字緊貼、開頭不對齊，第二行往右錯開；since 徽章和簡介再往右下一階，
    整體是一條從左上往右下的斜線，視線自然走到按鈕和簡介
  */
  /* --gutter：兩行之間的上下距離 = 最後一行跟按鈕的左右距離，視覺上一致 */
  /* 3D 頁、編織頁的大字：電腦版固定 85px（平板、手機在下方另外縮小） */
  .stair,
  :lang(zh-Hant-TW) .stair {
    justify-items: start;
    font-size: 85px;
    gap: var(--gutter);
    --step: 1.1em;
    --gutter: 0.3em;
  }

  .stair .row {
    margin-left: calc(var(--i) * var(--step));
  }

  .stair .last {
    gap: var(--gutter);
  }

  .stair .foot {
    gap: 0.25em;
  }

  /* 簡介可以縮、可以換行，不會把版面撐出畫面 */
  .stair {
    max-width: 100%;
  }

  .stair .foot {
    max-width: calc(100% - var(--i) * var(--step));
  }

  .stair .foot .lead {
    flex-shrink: 1;
    min-width: 0;
    max-width: 24em;
    text-align: left;
  }

  /*
    玻璃 3D 字：
    - 字填色是由上而下的漸層（亮 → 半透明），像霧面玻璃
    - 細亮邊當玻璃邊緣
    - 兩層往右下偏移的 drop-shadow 疊出厚度，再加一圈光暈
    - 三行放在不同深度，滑鼠傾斜時會有前後層次
    淺色主題用深色玻璃，深色主題用白色玻璃
  */
  .glass {
    --g1: var(--ink);
    --g2: color-mix(in srgb, var(--ink) 72%, transparent);
    --g3: color-mix(in srgb, var(--ink) 30%, transparent);
    --edge: color-mix(in srgb, var(--ink) 35%, transparent);
    --depth: rgb(255 255 255 / 0.65);
    --halo: transparent;
    perspective: 1100px;
  }

  :global(html[data-theme='crystal']) .glass {
    --g1: #ffffff;
    --g2: rgb(236 234 246 / 0.78);
    --g3: rgb(188 184 213 / 0.32);
    --edge: rgb(255 255 255 / 0.5);
    --depth: rgb(60 70 140 / 0.55);
    --halo: color-mix(in srgb, var(--lavender) 45%, transparent);
  }

  .glass .headline {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.35s ease-out;
  }

  .glass .row {
    transform: translateZ(calc((2 - var(--i, 0)) * 16px));
  }

  /* 手機不會傾斜，也不需要前後深度（避免第一行被放大貼到邊緣） */
  @media (max-width: 809px) {
    .glass .row {
      transform: none;
    }
  }

  .glass :global(.txt) {
    color: transparent;
    background: linear-gradient(180deg, var(--g1) 8%, var(--g2) 55%, var(--g3) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0.012em var(--edge);
    text-shadow: none;
    filter:
      drop-shadow(0.012em 0.018em 0 var(--depth))
      drop-shadow(0.012em 0.018em 0 var(--depth))
      drop-shadow(0 0 0.28em var(--halo));
  }

  /* 平板：主欄比較窄，字級比例放大一點 */
  @media (min-width: 810px) and (max-width: 1199px) {
    .headline {
      font-size: 13cqi;
    }

    :lang(zh-Hant-TW) .headline {
      font-size: 11cqi;
    }

    /* 平板塞不下 85px，跟著主欄寬度縮小，最大不超過 85px */
    .stair,
    :lang(zh-Hant-TW) .stair {
      font-size: min(85px, 11.5cqi);
      --step: 0.8em;
    }
  }

  /* 手機：每段字各自一行、字放大，簡介夾在中間，按鈕放最下面 */
  @media (max-width: 809px) {
    .hero {
      min-height: auto;
      padding-block: 48px 56px;
    }

    .headline,
    :lang(zh-Hant-TW) .headline {
      font-size: max(2.4rem, 17cqi);
      gap: 0.06em;
    }

    .row {
      flex-direction: column;
      gap: 0.06em;
    }

    .r2 .lead {
      max-width: 19em;
      margin: 0.3em 0 0.2em auto;
    }

    .ctas {
      flex-direction: row;
      margin-top: 0.5em;
    }

    /* 手機的階梯（中英文共用）：字小一點、行距拉開，左右留白；按鈕移到最下面 */
    .stair,
    :lang(zh-Hant-TW) .stair {
      font-size: 13cqi;
      gap: 0.2em;
      --step: 0.55em;
    }

    .stair .foot {
      margin-top: 0.35em;
      gap: 0.3em;
    }

    .stair .foot .lead {
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .stair .row {
      flex-direction: row;
    }

    .stair .last {
      display: contents;
    }

    /* 最後一行被拆開了（display: contents），縮排改加在字上；--i 會從 .last 繼承下來 */
    .stair .last .big {
      margin-left: calc(var(--i) * var(--step));
    }

    .stair .foot {
      order: 1;
      max-width: calc(100% - var(--i) * var(--step));
    }

    .stair .ctas {
      order: 2;
      justify-self: center;
      margin-top: 28px;
    }
  }
</style>
