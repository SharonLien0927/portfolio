---
import { render, type CollectionEntry } from 'astro:content';
import BigLines from '../BigLines.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  page: CollectionEntry<'pages'>;
}

const { lang, page } = Astro.props;
const { Content } = await render(page);
const [l1 = page.data.title, l2 = '', l3 = ''] = page.data.lines ?? [];
const since = page.data.since;
const sinceLabel = t(lang)('since');
---

<section class="hero">
  <h1 class="visually-hidden">{page.data.title}</h1>
  <div class="headline">
    <div class="row" aria-hidden="true"><span class="big"><BigLines text={l1} since={since} sinceLabel={sinceLabel} /></span></div>
    <div class="row r2">
      <div class="lead"><Content /></div>
      <span class="big" aria-hidden="true"><BigLines text={l2} since={since} sinceLabel={sinceLabel} /></span>
    </div>
    <div class="row r3">
      <span class="big" aria-hidden="true"><BigLines text={l3} since={since} sinceLabel={sinceLabel} /></span>
      <div class="ctas"><slot /></div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    place-items: center;
    min-height: clamp(420px, 62svh, 640px);
    padding-block: 40px;
  }

  /* 字級跟著主欄寬度（cqi）縮放：大螢幕更大、平板自動換行 */
  .headline {
    display: grid;
    justify-items: center;
    gap: 0.1em;
    font: 700 max(2.6rem, 10.5cqi) / 0.95 var(--font-display);
    letter-spacing: -0.02em;
    text-align: center;
  }

  /* 中文字是滿版方塊，同字級看起來比英文大，縮一點 */
  :lang(zh-Hant-TW) .headline {
    font-size: max(2.4rem, 8.6cqi);
    letter-spacing: 0.02em;
  }

  html:lang(en) .big {
    text-transform: lowercase;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.3em;
  }

  .lead {
    flex-shrink: 0;
    max-width: 23em;
    font: 400 clamp(0.85rem, 1.15cqi, 1.05rem) / 1.45 var(--font-body);
    letter-spacing: 0;
    text-align: right;
    color: var(--muted);
  }

  .lead :global(p) {
    margin: 0;
  }

  .ctas {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 8px;
    font-size: clamp(0.95rem, 1.3cqi, 1.2rem);
    letter-spacing: 0;
  }

  .ctas :global(.btn) {
    justify-content: center;
    padding: 0.85em 1.4em;
    font-size: inherit;
  }

  /* 平板：主欄比較窄，字級比例放大一點 */
  @media (min-width: 810px) and (max-width: 1199px) {
    .headline {
      font-size: 13cqi;
    }

    :lang(zh-Hant-TW) .headline {
      font-size: 11cqi;
    }
  }

  /* 手機：每段字各自一行、字放大，簡介夾在中間，按鈕放最下面 */
  @media (max-width: 809px) {
    .hero {
      min-height: auto;
      padding-block: 48px 56px;
    }

    .headline,
    :lang(zh-Hant-TW) .headline {
      font-size: max(2.4rem, 17cqi);
      gap: 0.06em;
    }

    .row {
      flex-direction: column;
      gap: 0.06em;
    }

    .r2 .lead {
      max-width: 19em;
      margin: 0.3em 0 0.2em auto;
    }

    .ctas {
      flex-direction: row;
      margin-top: 0.5em;
    }
  }
</style>
