---
import ServiceCard from '../ServiceCard.astro';
import Logo from '../Logo.astro';
import { getLocalized } from '../../lib/content';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const services = await getLocalized('services', lang);
const groups = [
  { key: 'digital', label: tr('services.digital') },
  { key: 'handmade', label: tr('services.handmade') },
] as const;
---

<section id="services" class="section">
  <div class="wrap">
    <h2 class="h2">{tr('services.title')}</h2>
    <div class="columns">
      {
        groups.map((g, gi) => (
          <div class="col" data-group={g.key}>
            <p class="group lc">
              <span class="dot" aria-hidden="true" />
              {g.label}
            </p>
            {services
              .filter((s) => s.data.group === g.key)
              .map((entry, i) => (
                <ServiceCard entry={entry} index={i + gi} />
              ))}
            {gi === groups.length - 1 && (
              <a class="ready" href="#contact">
                <Logo size={22} />
                <span class="ready-text lc">{tr('services.ready')}</span>
                <span class="ready-link lc">{tr('services.readyBtn')} →</span>
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 16px;
  }

  /* 右欄往下錯開，做出交錯的節奏 */
  .col {
    display: grid;
    gap: 16px;
  }

  .col + .col {
    margin-top: 64px;
  }

  .group {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 600 1rem/1 var(--font-display);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--sky);
  }

  [data-group='handmade'] .dot {
    background: var(--leaf);
  }

  .ready {
    display: grid;
    gap: 14px;
    min-height: 190px;
    align-content: start;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .ready-text {
    font: 600 clamp(1.4rem, 2.6vw, 1.75rem) / 1.15 var(--font-display);
    color: rgb(255 253 234 / 0.85);
  }

  .ready-link {
    align-self: end;
    color: var(--butter);
    font-weight: 500;
  }

  .ready:hover .ready-text {
    color: var(--paper);
  }

  @media (max-width: 809px) {
    .columns {
      grid-template-columns: 1fr;
    }

    .col + .col {
      margin-top: 16px;
    }
  }
</style>
