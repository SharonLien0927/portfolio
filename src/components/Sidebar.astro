---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import type { NavItem } from '../lib/nav';
import { localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';

interface Props {
  lang: Lang;
  alternate: string;
  items: NavItem[];
  /** 一開始就展開的項目（案例頁用） */
  current?: string;
}

const { lang, alternate, items, current } = Astro.props;
const tr = t(lang);
---

<aside class="side" data-sidebar>
  <div class="top">
    <a class="home" href={localePath(lang)}>
      <Logo />
      <span class="visually-hidden">{site.name[lang]}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="side-body">
      <span class="bars" aria-hidden="true"></span>
      <span class="visually-hidden">{tr('nav.menu')}</span>
    </button>
  </div>

  <div class="body" id="side-body">
    <nav aria-label="Main">
      <ol class="nav">
        {
          items.map((item, i) => (
            <li data-target={item.id} class:list={{ open: item.id === current }}>
              <a class="pill lc" href={item.href}>
                <span>{item.label}</span>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
              </a>
              {item.detail && (
                <div class="detail">
                  <div class="detail-inner">
                    <div class="detail-card">
                      {item.detail.badge && (
                        <p class="badge">
                          <span>{item.detail.badge.top}</span>
                          <strong>{item.detail.badge.value}</strong>
                        </p>
                      )}
                      {item.detail.text && <p class="text">{item.detail.text}</p>}
                      {item.detail.bullets && (
                        <ul class="bullets">
                          {item.detail.bullets.map((b) => (
                            <li>{b}</li>
                          ))}
                        </ul>
                      )}
                      {item.detail.path && (
                        <div class="path">
                          <p class="muted">{item.detail.path.label}</p>
                          <p class="steps lc">
                            {item.detail.path.steps.map((s, si) => (
                              <>
                                {si > 0 && <span class="sep">›</span>}
                                <strong>{s}</strong>
                              </>
                            ))}
                          </p>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="bottom">
      <p class="cta lc">{tr('side.cta')}</p>
      <a class="btn" href={items.find((i) => i.id === 'contact')?.href ?? localePath(lang, '#contact')}>{tr('side.ctaBtn')}</a>
      <div class="foot">
        <div class="foot-row">
          <small>© {new Date().getFullYear()} {site.name[lang]}</small>
          <LangSwitch lang={lang} alternate={alternate} />
        </div>
        <ul class="socials">
          {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</aside>

<script>
  const side = document.querySelector<HTMLElement>('[data-sidebar]')!;
  const btn = side.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const items = [...side.querySelectorAll<HTMLLIElement>('.nav > li')];

  const setMenu = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    side.classList.toggle('menu-open', open);
  };
  btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  side.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // 捲到哪個區塊，側欄就展開哪一項（最後一個頂端已經過畫面中線的區塊；捲到底就是最後一個）
  const targets = items
    .map((li) => document.getElementById(li.dataset.target!))
    .filter((el): el is HTMLElement => !!el)
    .sort((a, b) => a.offsetTop - b.offsetTop);
  if (targets.length) {
    const update = () => {
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
      const passed = targets.filter((el) => el.getBoundingClientRect().top < innerHeight * 0.5);
      const active = atBottom ? targets.at(-1) : passed.at(-1);
      items.forEach((li) => li.classList.toggle('open', !!active && li.dataset.target === active.id));
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .side {
    position: sticky;
    top: var(--gap);
    display: flex;
    flex-direction: column;
    height: calc(100svh - 2 * var(--gap));
    padding: 20px 16px 16px;
    border-radius: var(--radius);
    background: var(--sky);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .home {
    display: inline-flex;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    min-height: 0;
    gap: 24px;
  }

  .nav {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav > li {
    border-radius: var(--radius);
    background: var(--butter);
    transition: background 0.25s;
  }

  .nav > li.open {
    background: var(--paper);
  }

  .pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    font: 600 0.95rem/1.3 var(--font-display);
    text-decoration: none;
  }

  .num {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 18px;
    border-radius: 999px;
    background: var(--white);
    font: 500 0.65rem/1 var(--font-body);
  }

  .open .num {
    background: var(--butter);
  }

  /* 0fr → 1fr 讓高度可以平滑展開 */
  .detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  .open .detail {
    grid-template-rows: 1fr;
  }

  .detail-inner {
    overflow: hidden;
  }

  .detail-card {
    padding: 2px 10px 12px;
    font-size: 0.8rem;
  }

  .detail-card p {
    margin: 0 0 6px;
  }

  .badge {
    display: inline-flex;
    flex-direction: column;
    padding: 6px 12px;
    border: 1.5px dashed var(--dash);
    border-radius: var(--radius);
    background: var(--white);
    line-height: 1.1;
  }

  .badge span {
    color: var(--sky);
    font-size: 0.75rem;
  }

  .badge strong {
    font: 600 1.1rem/1.2 var(--font-display);
  }

  .text {
    padding: 6px 8px;
    border: 1.5px dashed var(--dash);
    border-radius: var(--radius);
  }

  .bullets {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .bullets li::before {
    content: '✿';
    margin-right: 6px;
    color: var(--sky);
  }

  .path .muted {
    margin: 6px 0 2px;
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 6px;
  }

  .sep {
    color: var(--muted);
  }

  .cta {
    margin: 0 0 14px;
    color: var(--paper);
    font: 700 1.35rem/1.15 var(--font-display);
  }

  .foot {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: var(--paper);
    font-size: 0.8rem;
  }

  .foot-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .socials {
    display: flex;
    gap: 12px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .socials a {
    font-weight: 500;
    text-decoration: none;
  }

  .socials a:hover {
    text-decoration: underline;
  }

  .menu-toggle {
    display: none;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius);
    background: var(--paper);
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 16px;
    height: 2px;
    margin-inline: auto;
    background: var(--ink);
    transition: transform 0.2s;
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
  }

  .bars::before { top: -5px; }
  .bars::after { top: 5px; }

  [aria-expanded='true'] .bars { background: transparent; }
  [aria-expanded='true'] .bars::before { transform: translateY(5px) rotate(45deg); }
  [aria-expanded='true'] .bars::after { transform: translateY(-5px) rotate(-45deg); }

  /* 桌機：側欄變寬，字也放大 */
  @media (min-width: 1200px) {
    .side {
      padding: 22px 20px 20px;
    }

    .top {
      margin-bottom: 22px;
    }

    .nav {
      gap: 8px;
    }

    .pill {
      padding: 9px 12px;
      font-size: 1.2rem;
    }

    .num {
      min-width: 26px;
      height: 22px;
      font-size: 0.72rem;
    }

    .detail-card {
      padding: 2px 12px 14px;
      font-size: 0.92rem;
    }

    .cta {
      margin-bottom: 18px;
      font-size: 1.65rem;
    }

    .bottom .btn {
      padding: 0.85em 1.6em;
      font-size: 1.05rem;
    }

    .foot {
      padding: 12px 14px;
      font-size: 0.9rem;
    }
  }

  /* 手機：側欄變成頂端的藍色橫條，選單往下展開 */
  @media (max-width: 809px) {
    .side {
      top: 12px;
      z-index: 50;
      height: auto;
      padding: 10px 12px;
    }

    .top {
      margin: 0;
    }

    .menu-toggle {
      display: block;
    }

    .body {
      display: none;
      max-height: calc(100svh - 90px);
      padding-top: 14px;
      overflow-y: auto;
    }

    .menu-open .body {
      display: flex;
    }

    .detail {
      display: none;
    }
  }
</style>
