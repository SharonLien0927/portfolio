---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'services'>;
  index: number;
}

const { entry, index } = Astro.props;
const { Content } = await render(entry);
---

<article class="service" data-group={entry.data.group}>
  <span class="num">{String(index + 1).padStart(2, '0')}</span>
  <h3>{entry.data.title}</h3>
  <div class="body muted"><Content /></div>
  {entry.data.tags.length > 0 && <ul class="tags">{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 28px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    background: var(--paper);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .service:hover {
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: 0 8px 0 var(--accent);
  }

  [data-group='digital'] { --accent: var(--sky); }
  [data-group='handmade'] {
    --accent: var(--leaf);
    border-style: dashed;
  }

  .num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--accent);
    font: 700 0.95rem/1 var(--font-display);
  }

  h3 {
    font-size: 1.5rem;
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .tags {
    margin-top: auto;
  }
</style>
