---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'services'>;
  index: number;
}

const { entry, index } = Astro.props;
const { Content } = await render(entry);
// 小貼紙的顏色組合，依序輪替；圖案固定是「方塊 + 毛線球」，跟標誌一樣
const pairs = [
  ['#30c0f0', '#fff385'],
  ['#67b935', '#fbefc7'],
  ['#fff385', '#30c0f0'],
];
const [a, b] = pairs[index % pairs.length];
---

<article class="service card" data-group={entry.data.group}>
  <div class="stickers" aria-hidden="true">
    <span style={`background:${a}`}>
      <svg viewBox="0 0 24 24"><path d="M12 3 20 7.5v9L12 21l-8-4.5v-9z" fill="none" stroke="#1c1b18" stroke-width="1.8" stroke-linejoin="round" /><path d="M12 12l8-4.5M12 12 4 7.5M12 12v9" stroke="#1c1b18" stroke-width="1.8" /></svg>
    </span>
    <span style={`background:${b}`}>
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="#1c1b18" stroke-width="1.8" /><path d="M5 10c4 2 9 1 13-3M5 14c5 2 10 1 14-3M9 4c-2 5-1 11 3 16" stroke="#1c1b18" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
    </span>
  </div>
  <h3>{entry.data.title}</h3>
  <div class="body muted"><Content /></div>
  {entry.data.tags.length > 0 && <ul class="tags">{entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>}
</article>

<style>
  .service {
    display: grid;
    gap: 10px;
    padding: 18px 18px 20px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .service:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
  }

  .stickers {
    display: flex;
    margin-bottom: 4px;
  }

  .stickers span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 2px solid var(--white);
    border-radius: 6px;
    box-shadow: 0 2px 6px rgb(28 27 24 / 0.15);
    transform: rotate(-8deg);
  }

  .stickers span + span {
    margin-left: -8px;
    transform: rotate(10deg) translateY(3px);
  }

  .stickers svg {
    width: 20px;
  }

  h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }

  .body {
    font-size: 0.92rem;
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
