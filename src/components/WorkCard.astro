---
// 3D 作品方塊：滑鼠移上去播影片，點了進案例頁
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { splitId } from '../lib/content';
import { assetUrl, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const { title, summary, year, category, cover, video } = entry.data;
const href = localePath(lang, `projects/${splitId(entry.id).slug}/`);
const tints = ['#30c0f0', '#67b935', '#fff385', '#fbefc7'];
---

<article class="work" data-category={category}>
  <a href={href} data-hover-video>
    <div class="media" style={`--tint: ${tints[index % tints.length]}`}>
      {
        cover ? (
          <Image src={cover} alt="" widths={[600, 900, 1300]} sizes="(min-width: 810px) 45vw, 100vw" />
        ) : (
          <div class="placeholder" aria-hidden="true" />
        )
      }
      {video && <video muted loop playsinline preload="none" data-src={assetUrl(video)} aria-hidden="true" />}
      <span class="tag cat">{category}</span>
    </div>
    <div class="meta">
      <h3>{title}</h3>
      <span class="year">{year}</span>
    </div>
    <p class="muted">{summary}</p>
  </a>
</article>

<style>
  .work a {
    display: block;
    text-decoration: none;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--tint);
  }

  .media :is(img, video),
  .placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media img {
    transition: transform 0.6s ease;
  }

  .media video {
    opacity: 0;
    transition: opacity 0.3s;
  }

  .media :global(video.playing) {
    opacity: 1;
  }

  .placeholder {
    background:
      radial-gradient(circle at 70% 30%, rgb(255 255 255 / 0.5), transparent 28%),
      linear-gradient(150deg, var(--tint), color-mix(in srgb, var(--tint), #1c1b18 25%));
  }

  .cat {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    color: var(--ink);
  }

  a:hover .media img {
    transform: scale(1.04);
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 14px 0 4px;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  a:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .year {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  p {
    margin: 0;
    font-size: 0.92rem;
  }
</style>
