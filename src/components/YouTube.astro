---
// YouTube 影片：先只顯示縮圖和播放鍵，點了才載入 YouTube 播放器（頁面放很多支也不會變慢）
// 360° 影片在電腦上可以用滑鼠拖曳轉動視角
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** YouTube 網址（youtu.be/... 或 youtube.com/watch?v=...）或影片 ID */
  url: string;
  title: string;
  /** 自訂縮圖；沒給就用 YouTube 的縮圖 */
  poster?: ImageMetadata;
  /** 縮圖用比較高畫質的版本（大尺寸播放器用） */
  large?: boolean;
}

const { url, title, poster, large = false } = Astro.props;
const id = url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? url;
const start = Number(url.match(/[?&]t=(\d+)/)?.[1] ?? 0);
const thumb = `https://i.ytimg.com/vi/${id}/${large ? 'maxresdefault' : 'hqdefault'}.jpg`;
---

<div class="yt" data-yt={id} data-start={start} data-title={title}>
  <button class="yt-play" type="button" aria-label={`▶ ${title}`}>
    {
      poster ? (
        <Image src={poster} alt="" widths={[600, 1000, 1600]} sizes="(min-width: 810px) 70vw, 100vw" />
      ) : (
        <img src={thumb} alt="" loading="lazy" decoding="async" />
      )
    }
    <span class="icon" aria-hidden="true"></span>
  </button>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-yt]')) {
    box.querySelector('button')!.addEventListener('click', () => {
      const { yt, start, title } = box.dataset;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${yt}?autoplay=1&rel=0&playsinline=1${Number(start) ? `&start=${start}` : ''}`;
      iframe.title = title ?? 'YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  }
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: inherit;
    background: #000;
  }

  .yt-play {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .yt-play :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, filter 0.3s;
  }

  .yt-play:hover :global(img) {
    transform: scale(1.03);
    filter: brightness(0.85);
  }

  .icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 44px;
    border-radius: 12px;
    background: rgb(20 20 30 / 0.75);
    transform: translate(-50%, -50%);
    transition: background 0.2s;
  }

  .icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 52%;
    border-width: 10px 0 10px 17px;
    border-style: solid;
    border-color: transparent transparent transparent #fff;
    transform: translate(-50%, -50%);
  }

  .yt-play:hover .icon {
    background: #ff0033;
  }

  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
