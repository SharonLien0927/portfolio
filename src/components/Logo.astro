---
// 標誌：跟首頁大標題一樣的 3D 方塊、毛線球
import Orb from './Orb.astro';

interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
---

<span class="logo" aria-hidden="true" style={`--s: ${size}px`}>
  <Orb kind="cube" size={`${size}px`} />
  <Orb kind="yarn" size={`${size}px`} />
</span>

<style>
  .logo {
    display: inline-flex;
    gap: calc(var(--s) * 0.3);
  }
</style>
