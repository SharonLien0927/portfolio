---
// 把 "把想像{cube}做成" 這類字串拆開，{cube}/{yarn}/{since} 換成圓形圖示
import Orb from './Orb.astro';

interface Props {
  text: string;
  since?: string;
  sinceLabel?: string;
}

const { text, since, sinceLabel = 'since' } = Astro.props;
const parts = text.split(/(\{\w+\})/).filter(Boolean);
---

{
  parts.map((part) => {
    if (part === '{cube}') return <Orb kind="cube" spin />;
    if (part === '{yarn}') return <Orb kind="yarn" />;
    if (part === '{since}')
      return (
        <span class="orb since">
          <span class="in">
            <span>{sinceLabel}</span>
            <strong>{since}</strong>
          </span>
        </span>
      );
    return <span>{part}</span>;
  })
}

<style>
  /* since 徽章跟 Orb 同尺寸、同對齊方式 */
  .since {
    display: inline-block;
    overflow: hidden;
    width: 0.82em;
    height: 0.82em;
    border: 0.02em solid var(--sky);
    border-radius: 50%;
    background: var(--white);
    color: var(--sky);
    text-transform: none;
    letter-spacing: 0;
    vertical-align: -0.06em;
  }

  .in {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.02em;
    height: 100%;
  }

  .in span {
    font: 500 0.15em/1 var(--font-body);
  }

  .in strong {
    font: 600 0.24em/1 var(--font-body);
  }
</style>
