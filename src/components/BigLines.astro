---
// 把 "把想{cube}像" 這類字串拆開，{cube}/{yarn}/{since} 換成圓形圖示
interface Props {
  text: string;
  since?: string;
  sinceLabel?: string;
}

const { text, since, sinceLabel = 'since' } = Astro.props;
const parts = text.split(/(\{\w+\})/).filter(Boolean);
---

{
  parts.map((part) => {
    if (part === '{cube}')
      return (
        <span class="orb cube">
          <svg viewBox="0 0 100 100">
            <path d="M50 18 80 35v32L50 84 20 67V35z" fill="#fffdea" />
            <path d="M50 52 80 35M50 52 20 35M50 52v32" stroke="#1c1b18" stroke-width="3" fill="none" />
            <path d="M50 18 80 35v32L50 84 20 67V35z" stroke="#1c1b18" stroke-width="3" fill="none" stroke-linejoin="round" />
          </svg>
        </span>
      );
    if (part === '{yarn}')
      return (
        <span class="orb yarn">
          <svg viewBox="0 0 100 100">
            <path d="M14 42c22 8 48 6 72-12M10 58c26 10 56 8 80-12M20 76c20 6 44 2 62-14M38 10c-8 26-6 56 12 84M60 8c-12 28-10 62 10 86" stroke="#1c1b18" stroke-width="3" fill="none" stroke-linecap="round" />
          </svg>
        </span>
      );
    if (part === '{since}')
      return (
        <span class="orb since">
          <span class="in">
            <span>{sinceLabel}</span>
            <strong>{since}</strong>
          </span>
        </span>
      );
    return <span>{part}</span>;
  })
}

<style>
  /* inline-block + overflow:hidden：基線固定在圓形底部，裡面有沒有文字都對齊 */
  .orb {
    display: inline-block;
    overflow: hidden;
    width: 0.82em;
    height: 0.82em;
    margin-inline: 0.03em;
    border-radius: 50%;
    vertical-align: -0.06em;
  }

  .orb svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .in {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.02em;
    height: 100%;
  }

  .cube {
    background: conic-gradient(from 200deg, var(--sky), #8fdcf6, var(--butter), var(--sky));
    animation: spin 14s linear infinite;
  }

  .yarn {
    background: radial-gradient(circle at 35% 30%, #9ad46f, var(--leaf) 60%);
  }

  .since {
    border: 0.02em solid var(--sky);
    background: var(--white);
    color: var(--sky);
    text-transform: none;
    letter-spacing: 0;
  }

  .in span {
    font: 500 0.15em/1 var(--font-body);
  }

  .in strong {
    font: 600 0.24em/1 var(--font-body);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
