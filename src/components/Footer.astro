---
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';

interface Props {
  lang: Lang;
  contactHref: string;
}

const { lang, contactHref } = Astro.props;
const tr = t(lang);
---

<footer class="footer">
  <h2>{tr('footer.title')}</h2>
  <a class="btn btn--butter" href={contactHref}>{tr('side.ctaBtn')}</a>
  <div class="row">
    <div>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="socials">
        {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
      </ul>
    </div>
    <small>© {new Date().getFullYear()} {site.name[lang]} · {tr('footer.rights')}</small>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    justify-items: start;
    gap: 22px;
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(28px, 5vw, 56px) clamp(20px, 4vw, 40px) 28px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
  }

  h2 {
    font-size: clamp(1.8rem, 4.5vw, 3.2rem);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    margin-top: clamp(24px, 6vw, 72px);
    color: rgb(255 253 234 / 0.75);
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--butter);
  }

  .socials {
    display: flex;
    gap: 16px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
