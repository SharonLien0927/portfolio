---
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
---

<footer class="footer">
  <div class="container inner">
    <div>
      <p class="name">{site.name[lang]}</p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <ul class="socials">
      {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
    </ul>
    <div class="bottom">
      <small>© {new Date().getFullYear()} {site.name[lang]}. {tr('footer.rights')}.</small>
      <a href="#top">{tr('footer.top')} ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 56px 32px;
    background: var(--ink);
    color: var(--paper);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
  }

  .name {
    margin-bottom: 4px;
    font: 700 clamp(1.8rem, 4vw, 2.6rem) / 1.1 var(--font-display);
  }

  .mail {
    color: var(--butter);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials a,
  .bottom a {
    text-decoration: none;
  }

  .socials a:hover,
  .bottom a:hover {
    color: var(--butter);
  }

  .bottom {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 253 234 / 0.2);
    color: rgb(255 253 234 / 0.7);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
