---
import ProjectView from '../../views/ProjectView.astro';
import { getLocalized, splitId } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getLocalized('projects', 'zh-tw');
  return entries.map((e) => ({ params: { slug: splitId(e.id).slug } }));
}

const { slug } = Astro.params;
---

<ProjectView lang="zh-tw" slug={slug} />
