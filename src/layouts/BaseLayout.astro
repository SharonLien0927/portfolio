---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource-variable/noto-sans-tc';
import '../styles/global.css';
import '../styles/theme-crystal.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import type { NavItem } from '../lib/nav';
import { getPage } from '../lib/content';
import { htmlLang, type Lang } from '../i18n/ui';
import { localePath, otherLang } from '../i18n/utils';
import { site } from '../config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 另一個語言的對應網址（語言切換鈕用） */
  alternate: string;
  nav: NavItem[];
  current?: string;
}

const { lang, title, description = '', alternate, nav, current } = Astro.props;
const hero = await getPage('hero', lang);
const fullTitle = title ? `${title} — ${site.name[lang]}` : site.name[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateHref = new URL(alternate, Astro.site);
const contactHref = nav.find((i) => i.id === 'contact')?.href ?? localePath(lang, '#contact');
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme={site.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang[lang]} href={canonical} />
    <link rel="alternate" hreflang={htmlLang[otherLang(lang)]} href={alternateHref} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={site.theme === 'crystal' ? '#0c0b18' : '#30c0f0'} />
  </head>
  <body>
    <div class="shell">
      <Sidebar lang={lang} alternate={alternate} items={nav} current={current} />
      <main class="main" id="main">
        <TopBar lang={lang} alternate={alternate} status={hero.data.eyebrow} since={hero.data.since} />
        <slot />
        <Footer lang={lang} contactHref={contactHref} />
      </main>
    </div>
  </body>
</html>
