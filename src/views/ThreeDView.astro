---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import FilterBar from '../components/FilterBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Showreel from '../components/Showreel.astro';
import Experience from '../components/sections/Experience.astro';
import HireContact from '../components/sections/HireContact.astro';
import { getLocalized, getPage } from '../lib/content';
import { threeDNav } from '../lib/nav';
import { localePath, otherLang, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const intro = await getPage('3d-intro', lang);
const process = await getPage('3d-process', lang);
const { Content: ProcessIntro } = await render(process);
const works = await getLocalized('projects', lang);
const categories = [...new Set(works.map((w) => w.data.category))];
// 一開始只顯示前幾件，按「顯示全部」才展開；選了分類就直接顯示該分類全部
const FIRST = 6;
const more = works.length - FIRST;
---

<BaseLayout
  zone="3d"
  lang={lang}
  title={tr('nav.3d')}
  description={intro.data.title}
  alternate={localePath(otherLang(lang), '3d/')}
  nav={threeDNav(lang)}
>
  <Hero lang={lang} page={intro}>
    <a class="btn btn--sky lc" href="#experience">{tr('threeD.cta')} →</a>
    <a class="btn btn--butter lc" href="#hire">{tr('hire.short')}</a>
  </Hero>

  <div class="reel-wrap"><Showreel lang={lang} withOlder /></div>

  <section id="works" class="section works">
    <h2 class="h2">{tr('threeD.works')}</h2>
    {categories.length > 1 && <FilterBar label={tr('filter.label')} allLabel={tr('filter.all')} categories={categories} target="work-grid" />}
    <div class="grid" id="work-grid" data-collapsed={more > 0 ? '' : undefined}>
      {works.map((entry, i) => <WorkCard entry={entry} lang={lang} index={i} />)}
    </div>
    {
      more > 0 && (
        <div class="more-wrap">
          <button type="button" class="btn btn--sky lc more" data-show-all>
            {tr('threeD.showAll')}（{tr('threeD.more').replace('{n}', String(more))}）↓
          </button>
        </div>
      )
    }
  </section>

  <Experience lang={lang} />

  <section id="process" class="section">
    <h2 class="h2">{process.data.title}</h2>
    <div class="process-intro muted"><ProcessIntro /></div>
    {process.data.steps && <ProcessSteps steps={process.data.steps} />}
  </section>

  <HireContact lang={lang} />
</BaseLayout>

<script>
  import '../scripts/hover-video.ts';

  const grid = document.getElementById('work-grid');
  const showAll = document.querySelector<HTMLButtonElement>('[data-show-all]');
  if (grid && showAll) {
    let expanded = false;
    showAll.addEventListener('click', () => {
      expanded = true;
      grid.removeAttribute('data-collapsed');
      showAll.parentElement!.hidden = true;
    });
    grid.addEventListener('filterchange', (e) => {
      const value = (e as CustomEvent<string>).detail;
      const collapse = !value && !expanded;
      grid.toggleAttribute('data-collapsed', collapse);
      showAll.parentElement!.hidden = !collapse;
    });
  }
</script>

<style>
  .reel-wrap {
    margin-bottom: clamp(16px, 3vw, 32px);
  }

  .works {
    padding-top: clamp(40px, 6vw, 80px);
  }

  /* 3D 作品用大方塊：桌機與平板兩欄、手機一欄 */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 20px;
  }

  /* 收合時只顯示前 6 件 */
  .grid[data-collapsed] > :global(:nth-child(n + 7)) {
    display: none;
  }

  .more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .more-wrap[hidden] {
    display: none;
  }

  @media (max-width: 809px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .process-intro {
    margin: -28px auto 32px;
    text-align: center;
  }
</style>
