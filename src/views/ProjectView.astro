---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTube from '../components/YouTube.astro';
import { getLocalized, splitId } from '../lib/content';
import { threeDNav } from '../lib/nav';
import { assetUrl, localePath, otherLang, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const tr = t(lang);
const entry = (await getEntry('projects', `${lang}/${slug}`))!;
const { Content } = await render(entry);
const { title, summary, year, role, client, tags, cover, video, film, youtube, videoGroups, tools, duration, links, galleries } = entry.data;

// 另一個語言有同名檔案就連過去，沒有就回另一個語言的作品列表
const other = otherLang(lang);
const translated = await getEntry('projects', `${other}/${slug}`);
const alternate = localePath(other, translated ? `projects/${slug}/` : '3d/');

const all = await getLocalized('projects', lang);
const next = all[(all.findIndex((p) => p.id === entry.id) + 1) % all.length];
const meta = [
  { label: tr('projects.year'), value: String(year) },
  { label: tr('projects.role'), value: role },
  { label: tr('projects.client'), value: client },
  { label: tr('projects.tools'), value: tools },
  { label: tr('projects.duration'), value: duration },
].filter((m) => m.value);
const nav = threeDNav(lang, false);
---

<BaseLayout
  zone="3d" lang={lang} title={title} description={summary} alternate={alternate} nav={nav} current="works">
  <article class="case">
    <a class="back lc" href={localePath(lang, '3d/#works')}>← {tr('projects.back')}</a>

    <header class="head">
      <ul class="tags">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
      <h1>{title}</h1>
      <p class="summary muted">{summary}</p>
    </header>

    <dl class="meta">
      {
        meta.map((m) => (
          <div>
            <dt class="muted lc">{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="hero-media">
      {
        youtube ? (
          <YouTube url={youtube} title={title} poster={cover} large />
        ) : film ? (
          <video src={assetUrl(film)} poster={cover?.src} controls playsinline preload="metadata" />
        ) : video ? (
          <video src={assetUrl(video)} poster={cover?.src} autoplay muted loop playsinline />
        ) : cover ? (
          <Image src={cover} alt="" widths={[800, 1200, 1800]} sizes="(min-width: 1000px) 70vw, 100vw" loading="eager" />
        ) : (
          <div class="placeholder" aria-hidden="true" />
        )
      }
    </div>

    {
      links.length > 0 && (
        <p class="links">
          <span class="muted lc">{tr('projects.links')}</span>
          {links.map((l) => (
            <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
          ))}
        </p>
      )
    }

    <div class="prose content"><Content /></div>

    {
      videoGroups.map((g) => (
        <section class="gallery videos">
          <h2>{g.title}</h2>
          {g.note && <p class="muted">{g.note}</p>}
          <div class="grid" style={`--cols: ${g.cols}`}>
            {g.items.map((v) => (
              <figure>
                <div class="frame">
                  {v.youtube ? (
                    <YouTube url={v.youtube} title={`${title}｜${v.title}`} />
                  ) : (
                    v.src && <video src={assetUrl(v.src)} poster={v.poster && assetUrl(v.poster)} controls playsinline preload="metadata" />
                  )}
                </div>
                <figcaption class="muted">{v.title}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }

    {
      galleries.map((g) => (
        <section class="gallery">
          <h2>{g.title}</h2>
          {g.note && <p class="muted">{g.note}</p>}
          <div class="grid" style={`--cols: ${g.cols}`}>
            {g.images.map((img) => (
              <div class="shot">
                <Image src={img} alt="" widths={[480, 800, 1200]} sizes={`(min-width: 810px) ${Math.round(100 / g.cols)}vw, 100vw`} />
              </div>
            ))}
          </div>
        </section>
      ))
    }

    {
      next && next.id !== entry.id && (
        <a class="next" href={localePath(lang, `projects/${splitId(next.id).slug}/`)}>
          <span class="muted lc">{tr('projects.next')}</span>
          <strong>{next.data.title}</strong>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </article>
</BaseLayout>

<style>
  .case {
    max-width: 1000px;
    margin-inline: auto;
    padding-top: clamp(32px, 6vw, 72px);
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  h1 {
    max-width: 18ch;
    margin-top: 14px;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
  }

  .summary {
    max-width: 52ch;
    margin: 16px 0 28px;
    font-size: 1.1rem;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin: 0;
    border-block: 1.5px dashed var(--dash);
  }

  .meta div {
    padding: 12px 0;
  }

  dt {
    font-size: 0.8rem;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .hero-media {
    margin-block: 32px;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .hero-media :is(img, video) {
    width: 100%;
    height: auto;
  }

  .placeholder {
    aspect-ratio: 16 / 8;
    background:
      radial-gradient(circle at 70% 35%, rgb(255 255 255 / 0.55), transparent 30%),
      radial-gradient(circle at 25% 80%, var(--leaf), transparent 45%),
      linear-gradient(160deg, var(--sky), #1d8fc0);
  }

  .content {
    margin-top: 40px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
  }

  .links .muted {
    margin-right: 6px;
    font-size: 0.85rem;
  }

  .gallery {
    margin-top: clamp(48px, 7vw, 80px);
  }

  .gallery h2 {
    margin-bottom: 8px;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
  }

  .gallery .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .videos figure {
    margin: 0;
  }

  .videos .frame {
    overflow: hidden;
    border-radius: 14px;
    background: #000;
  }

  .videos video {
    display: block;
    width: 100%;
    max-height: 70vh;
  }

  .videos figcaption {
    margin-top: 6px;
    font-size: 0.85rem;
  }

  .gallery .grid .shot {
    display: block;
    overflow: hidden;
    border-radius: 14px;
    /* 去背的產品圖（透明 PNG）襯一個淡淡的底色 */
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .gallery .grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }

  @media (max-width: 809px) {
    .gallery .grid {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
      gap: 8px;
    }
  }

  .next {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4px 16px;
    margin-top: 72px;
    padding: 20px 0;
    border-block: 1.5px dashed var(--dash);
    text-decoration: none;
    transition: padding 0.2s, background 0.2s;
  }

  .next:hover {
    padding-inline: 12px;
    background: var(--cream);
  }

  .next .muted {
    grid-column: 1;
    font-size: 0.85rem;
  }

  .next strong {
    grid-column: 1;
    font: 600 clamp(1.4rem, 3vw, 2rem) / 1.2 var(--font-display);
  }

  .arrow {
    grid-row: 1 / 3;
    grid-column: 2;
    font-size: 1.6rem;
  }
</style>
