---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CrochetCard from '../components/CrochetCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { getLocalized, getPage } from '../lib/content';
import { crochetNav } from '../lib/nav';
import { localePath, otherLang, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const intro = await getPage('crochet-intro', lang);
const process = await getPage('crochet-process', lang);
const { Content: ProcessIntro } = await render(process);
const pieces = await getLocalized('crochet', lang);
---

<BaseLayout
  lang={lang}
  title={tr('nav.crochet')}
  description={intro.data.title}
  alternate={localePath(otherLang(lang), 'crochet/')}
  nav={crochetNav(lang)}
>
  <Hero lang={lang} page={intro}>
    <a class="btn btn--leaf lc" href={localePath(lang, '#contact')}>{tr('crochet.cta')} →</a>
    <a class="btn btn--butter lc" href="#process">{tr('nav.process')}</a>
  </Hero>

  <section id="works" class="section works">
    <h2 class="h2">{tr('crochet.works')}</h2>
    <div class="grid">
      {pieces.map((entry, i) => <CrochetCard entry={entry} lang={lang} index={i} />)}
    </div>
  </section>

  <section id="process" class="section">
    <h2 class="h2">{process.data.title}</h2>
    <div class="process-intro muted"><ProcessIntro /></div>
    {process.data.steps && <ProcessSteps steps={process.data.steps} />}
  </section>

  <section id="soon" class="section soon">
    <ComingSoon lang={lang} />
  </section>
</BaseLayout>

<style>
  .works {
    padding-top: 0;
  }

  /* 桌機三欄、平板兩欄、手機一欄 */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 1199px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 809px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .process-intro {
    margin: -28px auto 32px;
    text-align: center;
  }

  .soon {
    padding-bottom: 0;
  }
</style>
